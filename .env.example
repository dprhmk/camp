# Copy to .env and adjust.

# Postgres connection string.
#   - Production: a Neon database URL (https://neon.tech, free tier).
#   - Local dev:  a Neon branch URL, or a local Postgres, e.g.
#                 postgresql://postgres:postgres@localhost:5432/camp
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Long random string used to sign session JWTs. Generate one with:
#   openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# Vercel Blob token — ONLY needed in production for member-photo uploads.
# Auto-injected by Vercel when a Blob store is linked to the project.
# Leave unset locally: uploads then fall back to ./public/uploads on disk.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
